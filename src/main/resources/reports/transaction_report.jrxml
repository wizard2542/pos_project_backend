<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "-//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transaction_report"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <!-- ─── Parameters ─────────────────────────────────────────── -->
    <parameter name="startDate"         class="java.lang.String"/>
    <parameter name="endDate"           class="java.lang.String"/>
    <parameter name="totalTransactions" class="java.lang.Integer"/>
    <parameter name="totalRevenue"      class="java.math.BigDecimal"/>

    <!-- ─── Fields (mapped from TransactionReportItemDTO) ─────── -->
    <field name="transactionId"   class="java.lang.Long"/>
    <field name="orderId"         class="java.lang.Long"/>
    <field name="orderNumber"     class="java.lang.String"/>
    <field name="transactionDate" class="java.time.LocalDateTime"/>
    <field name="paymentMethod"   class="java.lang.String"/>
    <field name="amount"          class="java.math.BigDecimal"/>
    <field name="changeAmount"    class="java.math.BigDecimal"/>
    <field name="status"          class="java.lang.String"/>
    <field name="cashierName"     class="java.lang.String"/>

    <!-- ─── Variables ──────────────────────────────────────────── -->
    <variable name="grandTotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <!-- ─── Title ──────────────────────────────────────────────── -->
    <title>
        <band height="80" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="782" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Transaction Report]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="32" width="782" height="18"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Period: " + $P{startDate} + " to " + $P{endDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="52" width="391" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Total Transactions: " + $P{totalTransactions}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="391" y="52" width="391" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total Revenue: " + $P{totalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ─── Column header ──────────────────────────────────────── -->
    <columnHeader>
        <band height="22" splitType="Stretch">
            <staticText>
                <reportElement mode="Opaque" x="0"   y="0" width="50"  height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[TXN ID]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="50"  y="0" width="120" height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Order #]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="170" y="0" width="140" height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="310" y="0" width="120" height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Cashier]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="430" y="0" width="100" height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Payment]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="530" y="0" width="100" height="22" backcolor="#217346"/>
                <textElement textAlignment="Right"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Amount  ]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="630" y="0" width="82"  height="22" backcolor="#217346"/>
                <textElement textAlignment="Right"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Change  ]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="712" y="0" width="70"  height="22" backcolor="#217346"/>
                <textElement textAlignment="Center"><font size="9" isBold="true" forecolor="#FFFFFF"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ─── Detail ─────────────────────────────────────────────── -->
    <detail>
        <band height="18" splitType="Stretch">
            <textField>
                <reportElement x="0"   y="0" width="50"  height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50"  y="0" width="120" height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{orderNumber}]]></textFieldExpression>
            </textField>
            <textField pattern="yyyy-MM-dd HH:mm">
                <reportElement x="170" y="0" width="140" height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="0" width="120" height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cashierName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="100" height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{paymentMethod}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="530" y="0" width="100" height="18"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="630" y="0" width="82"  height="18"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{changeAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="712" y="0" width="70"  height="18"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ─── Summary ────────────────────────────────────────────── -->
    <summary>
        <band height="30" splitType="Stretch">
            <line>
                <reportElement x="0" y="2" width="782" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="8" width="480" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Grand Total:   ]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="480" y="8" width="302" height="18"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{grandTotal}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
